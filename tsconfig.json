{
    "$schema": "https://raw.githubusercontent.com/MCJack123/TypeScriptToLua/master/tsconfig-schema.json",
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext"],
        "moduleResolution": "nodenext",
        "module": "nodenext",
        "strict": true,
        "typeRoots": ["./types", "./node_modules"],
        "types": ["@jackmacwindows/lua-types/cc"],
        "paths": {
            "CCKit2/*": ["./src/CCKit2/*"]
        },
        "rootDir": "src",
        "outDir": "bin",
        "declaration": true,
        "removeComments": false,
        "jsx": "react",
        "jsxFactory": "CCJSX.createElement"
    },
    "tstl": {
        "luaTarget": "CC",
        "luaLibImport": "require",
        "luaLibName": "typescript",
        "luaPlugins": [
            {"name": "./typecheck.ts"},
            {"name": "./makells.ts"},
        ]
    },
    "include": [
        "./src/CCKit2/*.ts",
        "./src/example/*.ts",
        "./src/example/*.tsx"
    ]
}
